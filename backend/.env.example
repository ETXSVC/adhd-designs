# Printify API token, generated at https://printify.com/app/account/api
PRINTIFY_API_TOKEN=

# The shop id to create draft products in (from GET /shops.json)
PRINTIFY_SHOP_ID=

# SQLite by default; swap for a Postgres URL later without changing code
DATABASE_URL=sqlite:///./app.db

# Where uploaded artwork is stored on disk
UPLOAD_DIR=./uploads

# Comma-separated list of origins allowed to call the API (the frontend's URL)
CORS_ORIGINS=http://localhost:5173

# Anthropic API key, generated at https://console.anthropic.com/settings/keys
# Used to generate AI-suggested title/description/tags for designs and
# products (POST /api/designs/{id}/ai-metadata, POST /api/products/ai-metadata).
# Leave blank to disable that feature -- the rest of the app works without it.
ANTHROPIC_API_KEY=

# Cheap by default -- this is a short vision + text-generation call, not a
# task that needs a frontier model. See CLAUDE.md before changing this.
ANTHROPIC_MODEL=claude-haiku-4-5
