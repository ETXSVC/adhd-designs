# Printify API token, generated at https://printify.com/app/account/api
PRINTIFY_API_TOKEN=

# The shop id to create draft products in (from GET /shops.json)
PRINTIFY_SHOP_ID=

# SQLite by default; swap for a Postgres URL later without changing code
DATABASE_URL=sqlite:///./app.db

# Where uploaded artwork is stored on disk
UPLOAD_DIR=./uploads

# Comma-separated list of origins allowed to call the API (the frontend's URL)
CORS_ORIGINS=http://localhost:5173
